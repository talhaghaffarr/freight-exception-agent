# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
dist/
build/

# Node
node_modules/
frontend/dist/
frontend/.vite/
playwright-report/
test-results/

# Celery Beat's local schedule state (regenerated on start)
backend/celerybeat-schedule*

# Environment
.env
.env.local
*.local

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local non-Docker dev convenience (no secrets, but machine-specific ports)
backend/.env.dev

# Walkthrough video workspace (parked; not part of the app build).
# The rendered walkthrough itself is committed; the frame stills and other
# render scratch under out/ are not.
video/node_modules/
video/out/*
!video/out/relayops-walkthrough.mp4

# Design canvas: keep the .dc.html sources, not the ~2MB seeded page
docs/design-directions/relayops-console.html
video/.venv-tts/
video/narration/*.wav

# Licensed audio: usable in the rendered video, not redistributable standalone
video/public/music.mp3
