# Local non-Docker development. Copy to .env.dev.
# No secrets here: these are local-only ports and a throwaway signing key.
DATABASE_URL=postgresql+psycopg://relayops:relayops@localhost:55433/relayops
CELERY_BROKER_URL=redis://localhost:56379/0
CELERY_RESULT_BACKEND=redis://localhost:56379/1
SECRET_KEY=local-demo-only-not-a-secret
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT_MODE=sandbox
SMTP_HOST=localhost
SMTP_PORT=1025
