# RelayOps local demo environment.
# Every value here is a conspicuously non-secret local default.
# Copy to .env and adjust only if you change compose ports.

# --- Core services -------------------------------------------------------
DATABASE_URL=postgresql+psycopg://relayops:relayops@postgres:5432/relayops
CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/1

# --- Application ---------------------------------------------------------
# Demo-only signing key. Rotate for any non-local deployment.
SECRET_KEY=local-demo-only-not-a-secret
CORS_ORIGINS=http://localhost:5173

# --- Safe-send switch ----------------------------------------------------
# sandbox   -> every message routes to local providers (default)
# allowlist -> live providers may send only to ALLOWLIST_RECIPIENTS
# live      -> external delivery permitted; requires ALLOW_LIVE_SENDS=true
ENVIRONMENT_MODE=sandbox
ALLOW_LIVE_SENDS=false
ALLOWLIST_RECIPIENTS=

# --- Local channel providers --------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_UI_URL=http://localhost:8025

# --- Optional live providers (leave blank for the sandbox demo) ----------
OPENAI_API_KEY=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VAPI_API_KEY=
OSRM_BASE_URL=

# --- Test harness --------------------------------------------------------
# Used by `make db-test-up`; integration tests refuse to run without it.
TEST_DATABASE_URL=postgresql+psycopg://relayops:relayops@localhost:55432/relayops_test
TEST_BROKER_URL=redis://localhost:56379/0
